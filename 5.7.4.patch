+
+        for (ShopCart cart : shopCart) {
+            orderItemMapper.insertSelective(new OrderItem(null, orderId, cart.getGoodsid(), cart.getGoodsnum()));
+        }
+
+        shopCartMapper.deleteByExample(shopCartExample);
+    }
 }
