+        ShopCartExample shopCartExample = new ShopCartExample();
+        shopCartExample.or().andUseridEqualTo(userId);
+        List<ShopCart> shopCart = shopCartMapper.selectByExample(shopCartExample);
+
+        for (ShopCart cart : shopCart) {
