+    var goodsname = $(this).parents("tr").find("td:eq(1)").text();
+    var goodsid = $(this).parents("tr").find("td:eq(0)").text();
+    swal({
+            title: "确定删除" + goodsname + "吗？",
+            type: "warning",
+            showCancelButton: true,
+            cancelButtonText:"取消",
+            confirmButtonColor: "#DD6B55",
+            confirmButtonText: "确定删除！",
