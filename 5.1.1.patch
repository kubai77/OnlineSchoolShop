-                return field;
-            }
-        }
-        // 否则，查看父类中是否存在此字段，如果有则返回
-        Class<?> superClazz = clazz.getSuperclass();
-        if (superClazz != null && superClazz != Object.class) {
-            //递归
-            return getFieldByName(fieldName, superClazz);
-        }
-        // 如果本类和父类都没有，则返回空
-        return null;
-    }
