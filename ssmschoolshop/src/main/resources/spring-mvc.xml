<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd http://www.springframework.org/schema/mvc http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!--SpringMVC的配置，包含网站跳转逻辑的控制配置-->
    <context:component-scan base-package="com.zhang.ssmschoolshop" use-default-filters="false">
        <!--只扫描控制器-->
        <context:include-filter type="annotation" expression="org.springframework.stereotype.Controller"></context:include-filter>
    </context:component-scan>

    <!--配置视图解析器，方便页面返回-->
    <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="prefix" value="/WEB-INF/views/"></property>
        <property name="suffix" value=".jsp"></property>
    </bean>

    <!--两个标准配置-->
    <!--将springmvc不能处理的请求交给tomcat-->
    <mvc:default-servlet-handler />
    <!--能支持springMVC的更高级的一些功能，JSP303校验，快捷的ajax。。映射动态请求-->
    <mvc:annotation-driven />

    <!-- 文件上传配置 -->
    <bean name="multipartResolver" class="org.springframework.web.multipart.commons.CommonsMultipartResolver">
        <!-- 默认编码 -->
        <property name="defaultEncoding" value="UTF-8"/>
        <!-- 上传文件大小限制为31M，31*1024*1024 -->
        <property name="maxUploadSize" value="32505856"/>
        <!-- 内存中的最大值 -->
        <property name="maxInMemorySize" value="4096"/>
    </bean>

    <!-- ==================== 统一权限拦截器 ==================== -->

    <!-- 后台管理拦截器：/admin/** 默认要求管理员登录，放行登录相关接口 -->
    <mvc:interceptors>
        <mvc:interceptor>
            <mvc:mapping path="/admin/**"/>
            <mvc:exclude-mapping path="/admin/login"/>
            <mvc:exclude-mapping path="/admin/confirmLogin"/>
            <bean class="com.zhang.ssmschoolshop.interceptor.AdminLoginInterceptor"/>
        </mvc:interceptor>

        <!-- 前台用户中心拦截器：用户相关操作要求用户登录 -->
        <mvc:interceptor>
            <mvc:mapping path="/info/**"/>
            <mvc:mapping path="/saveInfo"/>
            <mvc:mapping path="/saveAddr"/>
            <mvc:mapping path="/deleteAddr"/>
            <mvc:mapping path="/insertAddr"/>
            <mvc:mapping path="/savePsw"/>
            <mvc:mapping path="/deleteList"/>
            <mvc:mapping path="/finishList"/>
            <mvc:mapping path="/addCart"/>
            <mvc:mapping path="/showcart"/>
            <mvc:mapping path="/cartjson"/>
            <mvc:mapping path="/update"/>
            <mvc:mapping path="/deleteCart/**"/>
            <mvc:mapping path="/order"/>
            <mvc:mapping path="/orderFinish"/>
            <mvc:mapping path="/collect"/>
            <mvc:mapping path="/deleteCollect"/>
            <mvc:mapping path="/comment"/>
            <bean class="com.zhang.ssmschoolshop.interceptor.UserLoginInterceptor"/>
        </mvc:interceptor>
    </mvc:interceptors>

</beans>